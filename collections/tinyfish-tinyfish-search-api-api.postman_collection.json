          "id": "bf0c668e-6dee-4803-9b81-40cf9425add1",
          "name": "Search the web",
          "request": {
            "name": "Search the web",
            "description": {
              "content": "Search the web and get structured results. Returns ranked results with titles, snippets, and URLs.\n\n**Location and language resolution:**\n- If `location` is set but `language` is not, the language auto-resolves to the most predominantly used language in that country.\n- If `language` is set but `location` is not, the location auto-resolves to the country where that language is most predominantly used.\n- If neither `location` nor `language` is set, defaults to `us` and `en`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) Search query"
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Country code for geo-targeted results"
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Language code for result language"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
