                              "failed"
                            ]
                          },
                          "request_origin": {
                            "type": "string"
                          },
                          "request_id": {
                            "type": "string",
                            "nullable": true
                          },
                          "text_length": {
                            "type": "integer",
                            "nullable": true
                          },
                          "links_count": {
                            "type": "integer"
                          },
                          "image_links_count": {
                            "type": "integer"
                          },
                          "latency_ms": {
                            "type": "number",
                            "nullable": true
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "error": {
                            "type": "string",
                            "nullable": true
                          }
                        },
                        "required": [
                          "id",
                          "url",
                          "final_url",
                          "title",
                          "description",
                          "language",
                          "author",
                          "published_date",
