              },
              {
                "name": "start_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_before",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "List Tetra browser session usage for the authenticated user. Returns session telemetry including duration, data transfer, mode, and status."
        }
